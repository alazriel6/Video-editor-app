<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:AiVideoEditor.App.Controls"
             x:Class="AiVideoEditor.App.Controls.PrecisionParameterRow"
             x:Name="RootRow"
             Height="28">

    <Grid ColumnDefinitions="95,*,58,44" Height="28" VerticalAlignment="Center">
        <!-- Column 0: Property Label (95px) -->
        <TextBlock Grid.Column="0"
                   x:Name="TxtLabel"
                   Text="{Binding #RootRow.Label}"
                   Foreground="#FF9A9AA6"
                   FontSize="11.5"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding #RootRow.Label}"/>

        <!-- Column 1: Slim Precision Slider (* Stretch) -->
        <Slider Grid.Column="1"
                x:Name="ParamSlider"
                Minimum="{Binding #RootRow.Minimum}"
                Maximum="{Binding #RootRow.Maximum}"
                Value="{Binding #RootRow.Value, Mode=TwoWay}"
                VerticalAlignment="Center"
                Margin="4,0,6,0"
                DoubleTapped="OnSliderDoubleTapped"/>

        <!-- Column 2: Dual-Mode Scrubbable & Direct-Type Value Box (58px) -->
        <controls:ScrubbableNumberBox Grid.Column="2"
                                      x:Name="ScrubBox"
                                      Minimum="{Binding #RootRow.Minimum}"
                                      Maximum="{Binding #RootRow.Maximum}"
                                      StepSize="{Binding #RootRow.StepSize}"
                                      FormatString="{Binding #RootRow.FormatString}"
                                      Suffix="{Binding #RootRow.Suffix}"
                                      Value="{Binding #RootRow.Value, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"/>

        <!-- Column 3: Keyframe & Reset Cluster (44px) -->
        <Grid Grid.Column="3" ColumnDefinitions="22,22" Width="44" HorizontalAlignment="Right" VerticalAlignment="Center">
            <!-- Diamond Keyframe Button -->
            <Button Grid.Column="0"
                    x:Name="BtnKeyframe"
                    Content="{Binding #RootRow.DiamondIcon}"
                    Command="{Binding #RootRow.ToggleKeyframeCommand}"
                    CommandParameter="{Binding #RootRow.KeyframePropertyKey}"
                    Width="20" Height="20" Padding="0"
                    FontSize="10" FontWeight="Bold"
                    Background="Transparent" BorderThickness="0"
                    Foreground="#FFF59E0B"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    IsVisible="{Binding #RootRow.ShowKeyframeControls}"
                    ToolTip.Tip="Add / Remove Keyframe at Playhead"/>

            <!-- Reset Button [↺] -->
            <Button Grid.Column="1"
                    x:Name="BtnReset"
                    Content="↺"
                    Width="20" Height="20"
                    Padding="0"
                    FontSize="11"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#FF4E5260"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="OnResetButtonClick"
                    ToolTip.Tip="Reset to Default"/>
        </Grid>
    </Grid>
</UserControl>
